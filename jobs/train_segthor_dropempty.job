#!/bin/bash
#SBATCH --job-name=segthor_dropempty
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:15:00
#SBATCH --account=gpuuva084
#SBATCH --output=slurm_%j.out

module load 2023
module load Python/3.11.3-GCCcore-12.3.0

cd ~/ai4mi_project
source ai4mi/bin/activate

# Smoke test: 2-patient/1-epoch check that --drop_empty_slices doesn't crash.
python main.py --test_pipeline --gpu --drop_empty_slices 0.9 --dest results/segthor/smoke_dropempty

# Real run, once the smoke test passes (needs data/SEGTHOR already built via make data/SEGTHOR):
# python main.py --dataset SEGTHOR --mode full --epochs 25 \
#     --dest results/segthor/dropempty --gpu --drop_empty_slices 0.9
