#!/bin/bash
# PARKED -- do not run yet. --target_spacing + center-crop to --shape 256x256 was found to
# discard 70-87% of the imaged cross-sectional area for every patient (crop keeps only a
# ~250mm-wide central window out of a ~500mm-wide chest CT slice), risking clipping the
# target organs. Needs either a validation check (do organ masks stay inside the crop for
# every patient?) or a larger --shape, before this is safe to actually train with.
#SBATCH --job-name=segthor_spacing
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:15:00
#SBATCH --account=gpuuva084
#SBATCH --output=slurm_%j.out

module load 2023
module load Python/3.11.3-GCCcore-12.3.0

cd ~/ai4mi_project
source ai4mi/bin/activate

# Smoke test ONLY -- checks the code path doesn't crash. Does NOT mean this is safe to
# train with for real: at --shape 256 256, --target_spacing 0.9766 center-crops away
# 70-87% of the imaged cross-section for every patient (see PARKED note above). Do not
# uncomment/run a real training command here until that's fixed or validated.
python main.py --test_pipeline --gpu --target_spacing 0.9766 \
    --data_dir data/SEGTHOR_smoke_spacing --dest results/segthor/smoke_spacing
