#!/bin/bash
#SBATCH --job-name=segthor_hu
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:15:00
#SBATCH --account=gpuuva084
#SBATCH --output=slurm_%j.out

module load 2023
module load Python/3.11.3-GCCcore-12.3.0

cd ~/ai4mi_project
source ai4mi/bin/activate

# Smoke test: --test_pipeline builds a tiny 2-patient HU-windowed dataset on the fly
# (via slice_segthor.py --hu_min/--hu_max under the hood) and checks it doesn't crash.
python main.py --test_pipeline --gpu --hu_min -1000 --hu_max 300 \
    --data_dir data/SEGTHOR_smoke_hu --dest results/segthor/smoke_hu

# Real run, once the smoke test passes. Unlike the smoke path, real training does NOT take
# --hu_min/--hu_max directly -- HU windowing must be baked in at preprocessing time first:
#   python slice_segthor.py --source_dir data/segthor_part1 --dest_dir data/SEGTHOR_hu \
#       --shape 256 256 --retains 5 --hu_min -1000 --hu_max 300 -p -1
# python main.py --dataset SEGTHOR --mode full --epochs 25 \
#     --dest results/segthor/hu --gpu --data_dir data/SEGTHOR_hu
