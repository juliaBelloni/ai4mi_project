#!/bin/bash
#SBATCH --job-name=toy2_ce
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:15:00
#SBATCH --account=gpuuva084
#SBATCH --output=slurm_%j.out

module load 2023
module load Python/3.11.3-GCCcore-12.3.0

cd ~/ai4mi_project
source ai4mi/bin/activate

# Smoke test: 1 epoch on the full (small) TOY2 dataset, just to check nothing crashes.
python main.py --test_pipeline --dataset TOY2 --gpu --dest results/toy2/smoke_test

# Real run, once the smoke test passes:
# python main.py --dataset TOY2 --mode full --epochs 25 --dest results/toy2/ce --gpu
